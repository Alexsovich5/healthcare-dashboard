# Healthcare Operations Dashboard - Environment Configuration
# Project: Integrated Healthcare Operations Dashboard
# Author: Alexander Efrem - IT Operations Specialist, AEL Dubai
# Copy this file to .env and fill in the values

# InfluxDB Configuration
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=ael-dubai
INFLUX_BUCKET=healthcare-metrics
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-in-production

# GraphQL Server
PORT=4000
NODE_ENV=production

# Frontend
VITE_API_URL=http://localhost:4000/graphql
VITE_WS_URL=ws://localhost:4000/graphql

# Authentication (Okta SSO)
OKTA_ISSUER=https://ael-dubai.okta.com/oauth2/default
OKTA_CLIENT_ID=your-okta-client-id
JWT_SECRET=your-jwt-secret-min-32-chars

# Grafana
GRAFANA_PASSWORD=change-me-in-production

# Dashboard Settings
REFRESH_INTERVAL=5000
DEFAULT_TIME_RANGE=1h
ENABLE_WEBSOCKET=true
MAX_QUERY_DEPTH=10
RATE_LIMIT_PER_MINUTE=100
